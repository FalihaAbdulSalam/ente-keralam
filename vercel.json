{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/((?!build|assets|css|js|images|fonts|favicons|storage|design|favicon\\.ico|robots\\.txt|site\\.webmanifest).*)",
            "destination": "/index.html"
        }
    ]
}
